# Copie para Backend/.env e preencha (o .env fica fora do Git)

# Mercado Livre: developers.mercadolivre.com.br > Meus aplicativos
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# O mesmo endereço cadastrado no aplicativo (o ML volta para ele com ?code=...)
ML_REDIRECT_URI=https://www.google.com.br/

# Módulo Obras de poços
# Chave mestra do monitoramento (IoT): texto longo e aleatório; a chave de cada aparelho é calculada dela.
IOT_CHAVE_MESTRA=
# Pasta dos GeoJSON do maperf (opcional; padrão Backend/dados/maperf)
# MAPERF_DIR=
